{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "ui_kits/app/components/**/*.ts",
    "scripts/**/*.ts",
    ".storybook/**/*.ts",
    "storybook-config/**/*.ts"
  ]
}

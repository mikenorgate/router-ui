export type Role = 'viewer' | 'operator' | 'admin';
export interface Session { user: { id: string; name: string; role: Role }; csrf_token: string; mode: 'fixture' | 'production' }
export interface AuthMethods { local: boolean; oidc?: { enabled: boolean; name?: string; login_url?: string } }
export interface Address { address: string; family?: string | number; valid_from?: string; valid_until?: string | null; source?: string; confidence?: string | number }
export interface Source { id: string; kind?: string; status?: string; observed_at?: string | null; lag_seconds?: number | null; coverage?: string; sampling_rate?: number | null; lost_records?: number | null; sequence_gaps?: number | null; last_sequence?: number | null }
export interface Device { id: string; name?: string; segment?: string; mac?: string; addresses?: Address[]; last_seen?: string | null; observed_at?: string | null; status?: string; sources?: Source[] }
export interface Flow { id: string; device_id?: string; source_ip?: string; destination_ip?: string; destination_name?: string; source_port?: number | null; destination_port?: number | null; protocol?: string; bytes_sent?: number | null; bytes_received?: number | null; started_at?: string; last_seen?: string; verdict?: 'allowed' | 'blocked' | 'unknown'; rule_id?: string; translated_source_ip?: string; translated_destination_ip?: string; sampling_rate?: number | null; evidence?: string; source_id?: string }
export interface Policy { id: string; device_id?: string; action?: string; scope?: string; name?: string; conditions?: string | Record<string, unknown>; installed?: boolean | null; applicable?: boolean | null; observed_match?: boolean | null; origin?: { producer?: string; policy_id?: string; revision?: string; source_ref?: string; group_id?: string }; table?: string; chain?: string; hook?: string; priority?: number | null; order?: number | null; observed_at?: string | null; expires_at?: string | null; counters_scope?: 'shared' | 'device' | 'unknown'; packets?: number | null; bytes?: number | null }
export interface ConsoleEvent { id: string; time?: string; kind?: string; severity?: string; title?: string; detail?: string; device_id?: string; rule_id?: string; source_id?: string }
export interface MetricRecord { id: string; label?: string; value?: number | null; unit?: string; observed_at?: string | null; status?: string; scope?: string }
export interface Series { id: string; label?: string; unit?: string; points?: { time: string; value?: number | null }[] }
export interface Overview { metrics?: MetricRecord[]; series?: Series[]; devices_total?: number | null; active_devices?: number | null; flows_total?: number | null; events?: ConsoleEvent[]; sources?: Source[] }
export interface DeviceDetail { device: Device; bindings?: Address[]; flows?: Flow[]; policies?: Policy[]; events?: ConsoleEvent[]; annotation?: { alias?: string; note?: string }; detail_restricted?: boolean }
export interface Collection<T> { items?: T[]; next_cursor?: string | null }
export interface Network { interfaces?: Record<string, unknown>[]; segments?: Record<string, unknown>[]; routes?: Record<string, unknown>[]; coverage_notes?: string[] }
export interface SystemInfo { version?: string; mode?: string; capabilities?: { id: string; supported?: boolean; reason?: string }[]; sources?: Source[]; storage?: { used_bytes?: number | null; budget_bytes?: number | null; raw_days?: number | null; history_days?: number | null; sampling_rate?: number | null }; listeners?: { address?: string; status?: string }[]; auth?: { oidc_enabled?: boolean; local_recovery?: boolean }; certificates?: { names?: string[]; expires_at?: string; status?: string }[] }

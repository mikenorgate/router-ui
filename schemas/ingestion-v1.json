{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:router-console:ingestion:v1",
  "title": "Router Console observation batch v1",
  "$ref": "#/$defs/Batch",
  "$defs": {
    "Address": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "valid_from": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "string"
        }
      },
      "required": []
    },
    "Device": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "name": {
          "type": "string"
        },
        "segment": {
          "type": "string"
        },
        "mac": {
          "type": "string"
        },
        "addresses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Address"
          }
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id"
      ]
    },
    "Flow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "device_id": {
          "type": "string"
        },
        "source_ip": {
          "type": "string"
        },
        "destination_ip": {
          "type": "string"
        },
        "destination_name": {
          "type": "string"
        },
        "source_port": {
          "type": "integer"
        },
        "destination_port": {
          "type": "integer"
        },
        "protocol": {
          "type": "string"
        },
        "bytes_sent": {
          "type": "integer"
        },
        "bytes_received": {
          "type": "integer"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seen": {
          "type": "string",
          "format": "date-time"
        },
        "verdict": {
          "enum": [
            "allowed",
            "blocked",
            "unknown"
          ]
        },
        "rule_id": {
          "type": "string"
        },
        "policy_revision": {
          "type": "string"
        },
        "binding_ref": {
          "type": "string"
        },
        "translated_source_ip": {
          "type": "string"
        },
        "translated_destination_ip": {
          "type": "string"
        },
        "sampling_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "required": [
        "id",
        "source_ip",
        "destination_ip",
        "started_at",
        "last_seen",
        "verdict",
        "sampling_rate"
      ]
    },
    "Origin": {
      "type": "object",
      "properties": {
        "producer": {
          "type": "string"
        },
        "policy_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "source_ref": {
          "type": "string"
        },
        "group_id": {
          "type": "string"
        }
      },
      "required": []
    },
    "Policy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "device_id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "conditions": {
          "type": "string"
        },
        "installed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "applicable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "table": {
          "type": "string"
        },
        "chain": {
          "type": "string"
        },
        "hook": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "order": {
          "type": "integer"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "counters_scope": {
          "enum": [
            "shared",
            "device",
            "unknown"
          ]
        },
        "packets": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "counters_scope"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "device_id": {
          "type": "string"
        },
        "rule_id": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        }
      },
      "required": [
        "id",
        "time"
      ]
    },
    "Source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "lag_seconds": {
          "type": "number"
        },
        "coverage": {
          "type": "string"
        },
        "sampling_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "lost_records": {
          "type": "integer"
        },
        "last_sequence": {
          "type": "integer"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "sequence_gaps": {
          "type": "integer"
        }
      },
      "required": []
    },
    "Network": {
      "type": "object",
      "properties": {
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "coverage_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": []
    },
    "DNS": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "device_id": {
          "type": "string"
        },
        "query": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id"
      ]
    },
    "Record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "kind": {
          "enum": [
            "device",
            "flow",
            "policy",
            "dns",
            "event",
            "network"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "kind",
        "observed_at",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "device"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/Device"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "flow"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/Flow"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "policy"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/Policy"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "dns"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/DNS"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "event"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/Event"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "network"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/Network"
              }
            }
          }
        }
      ]
    },
    "Batch": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "boot_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4611686018427387904
        },
        "cursor": {
          "type": "string",
          "maxLength": 2048
        },
        "coverage": {
          "type": "string",
          "maxLength": 1024
        },
        "sampling_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "lost_records": {
          "type": "integer"
        },
        "records": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/Record"
          }
        }
      },
      "required": [
        "version",
        "source_id",
        "boot_id",
        "sequence",
        "sampling_rate",
        "records"
      ],
      "additionalProperties": false
    }
  },
  "description": "Transport bounds, UID authorization, clock tolerance, shared-counter evidence and monotonic sequences are additionally enforced by the application."
}
